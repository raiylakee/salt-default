{
  "format_on_save": "on",
  "tab_size": 2,
  "hard_tabs": false,
  "languages": {
    "C++": {
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": {
        "language_server": {
          "name": "clangd",
        },
      },
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--clang-tidy",
          "--fallback-style=GNU",
          "--compile-commands-dir=builddir",
        ],
      },
    },
  },
}
